# KagazReady — environment reference.
#
# There are no application secrets. Lambda functions receive their configuration from the SAM
# stack parameters (services/samconfig.toml), and the frontend needs exactly one build-time value.
#
# Frontend (apps/web/.env.local, gitignored) — the CloudFormation output ApiBaseUrl, no trailing slash:
VITE_API_BASE_URL=https://example.execute-api.ap-south-1.amazonaws.com/prod

# Tests (shell environment, never a file):
#   RUN_AWS_TESTS=1     run the live Textract tests in fixtures/ (needs `aws login`, ap-south-1)
#   E2E_BASE_URL=...    the public URL Playwright runs the demo journey against

# SAM (shell environment): keep build metadata on this machine.
#   SAM_CLI_TELEMETRY=0
